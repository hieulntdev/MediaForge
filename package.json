{
  "name": "mediaforge",
  "version": "1.0.0",
  "description": "Modular desktop toolkit for media workflows",
  "main": "apps/desktop/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node scripts/run-desktop.js",
    "bootstrap:runtimes": "bash scripts/bootstrap-runtimes.sh",
    "check": "node scripts/check-javascript.js",
    "test:node": "node --test tests/desktop/*.test.js",
    "test:python": "node scripts/run-python-tests.js",
    "test": "npm run check && npm run test:node && npm run test:python",
    "health": "node scripts/health-check.js"
  },
  "devDependencies": {
    "electron": "44.4.5"
  }
}
